{
  "name": "ToolRequest",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "description": "R\u00e9sum\u00e9 court de la t\u00e2che probl\u00e9matique d\u00e9crite par l'utilisateur"
    },
    "conversation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      },
      "description": "Conversation compl\u00e8te entre l'utilisateur et Armand"
    },
    "analysis": {
      "type": "object",
      "description": "Fiche de l'outil propos\u00e9 par Armand",
      "properties": {
        "nom_provisoire": {
          "type": "string"
        },
        "probleme_resolu": {
          "type": "string"
        },
        "fonctionnement": {
          "type": "string"
        },
        "automatise": {
          "type": "string"
        },
        "restant_a_faire": {
          "type": "string"
        },
        "temps_economise": {
          "type": "string"
        },
        "interfaces": {
          "type": "string"
        },
        "donnees_necessaires": {
          "type": "string"
        },
        "difficulte": {
          "type": "string"
        },
        "limites": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "requested"
      ],
      "default": "requested"
    }
  },
  "required": [
    "summary"
  ]
}