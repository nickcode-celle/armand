async function buildEntityMemory(apiKey, previousMemory, newConversation) {
  for (let attempt = 0; attempt < 2; attempt += 1) {
    const retryInstruction = attempt === 0
      ? ''
      : '\nATTENTION : ta réponse précédente n’était pas un JSON valide. Retourne uniquement un JSON strictement valide.';

    const prompt = `${MEMORY_PROMPT}${retryInstruction}

--- MÉMOIRE PRÉCÉDENTE ---

${previousMemory ? JSON.stringify(previousMemory, null, 2) : "Aucune mémoire précédente. Initialise la mémoire."}

--- NOUVEAUX ÉCHANGES À INTÉGRER ---

${newConversation}

IMPORTANT :
Mets à jour la mémoire précédente uniquement avec ce que ces nouveaux échanges justifient.
Conserve les éléments antérieurs qui ne sont ni corrigés ni rendus obsolètes.
Ne reconstruis pas la mémoire depuis zéro.`;

    const text = await openai(apiKey, prompt, {
      maxOutputTokens: 1800,
      temperature: 0.15,
    });

    const cleaned = String(text || '')
      .trim()
      .replace(/^```json\s*/i, '')
      .replace(/```$/i, '')
      .trim();

    try {
      return JSON.parse(cleaned);
    } catch {
      console.warn(`[entity] mémoire JSON invalide — tentative ${attempt + 1}/2`);
    }
  }

  return null;
}

function sendJson(res, status, payload) {
  res.writeHead(status, {
    'Content-Type': 'application/json; charset=utf-8',
    'Cache-Control': 'no-store',
  });
  res.end(JSON.stringify(payload));
}

async function readJson(req) {
  let body = '';
  for await (const chunk of req) body += chunk;
  return body ? JSON.parse(body) : {};
}

function transcript(messages) {
  return messages
    .map((m) => `${m.role === 'user' ? 'Utilisateur' : 'Entité'} : ${m.content}`)
    .join('\n\n');
}

function wordCount(text) {
  return String(text || '').trim().split(/\s+/).filter(Boolean).length;
}





function explicitDeparture(text) {
  const value = String(text || '').trim();
  if (/^(j['’]?y vais|je file|à plus|a plus|salut|bonne soirée|bonne soiree|bonne nuit|bye|ciao)[!.?\s]*$/i.test(value)) return 'effective';
  if (/(je dois te laisser|je vais devoir te laisser|je dois bientôt partir|je dois bientot partir|je vais y aller)/i.test(value)) return 'annoncee';
  return 'aucune';
}



async function openai(apiKey, text, { maxOutputTokens = 1200, temperature = 0.7 } = {}) {
  const response = await fetch('https:' + '//' + 'api.openai.com/v1/responses', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${apiKey}`,
    },
    body: JSON.stringify({
      model: process.env.ENTITY_OPENAI_MODEL || 'gpt-5.4',
      input: text,
      temperature,
      max_output_tokens: maxOutputTokens,
    }),
  });

  const data = await response.json();

  if (!response.ok) {
    throw new Error(`OpenAI ${response.status}: ${JSON.stringify(data)}`);
  }

  const output = data?.output
    ?.flatMap((item) => item?.content || [])
    ?.filter((item) => item?.type === 'output_text')
    ?.map((item) => item?.text || '')
    ?.join('')
    ?.trim();

  if (!output) throw new Error("OpenAI n'a renvoyé aucun contenu");

  return output;
}

function validateMessage(message, departure) {
  if (!message) return 'message vide';

  if (/\bVous\s*$/.test(message) && wordCount(message) > 6) {
    return 'phrase tronquée';
  }

  if (
    departure === 'aucune'
    && /(à la prochaine|au revoir|bonne fin de journée|bonne fin de journee|bonne soirée|bonne soiree|passe une bonne|à bientôt|a bientot)/i.test(message)
  ) return 'clôture interdite';

  return null;
}

async function getEmbedding(apiKey, text) {
  const response = await fetch('https://' + 'api.openai.com/v1/embeddings', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${apiKey}`,
    },
    body: JSON.stringify({
      model: process.env.ENTITY_EMBEDDING_MODEL || 'text-embedding-3-small',
      input: String(text || ''),
    }),
  });

  const data = await response.json();

  if (!response.ok) {
    throw new Error(`OpenAI embeddings ${response.status}: ${JSON.stringify(data)}`);
  }

  const embedding = data?.data?.[0]?.embedding;
  if (!Array.isArray(embedding)) throw new Error('Embedding introuvable');

  return embedding;
}

function cosineSimilarity(a, b) {
  if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) return 0;

  let dot = 0;
  let normA = 0;
  let normB = 0;

  for (let i = 0; i < a.length; i += 1) {
    dot += a[i] * b[i];
    normA += a[i] * a[i];
    normB += b[i] * b[i];
  }

  if (!normA || !normB) return 0;

  return dot / (Math.sqrt(normA) * Math.sqrt(normB));
}

function collectMemoryCandidates(memory) {
  if (!memory || typeof memory !== 'object') return [];

  const candidates = [];

  function add(type, item, path) {
    if (!item || typeof item !== 'object') return;

    const text = JSON.stringify(item);
    if (text.length < 20) return;

    candidates.push({
      type,
      path,
      item,
      text,
    });
  }

  const collections = [
    ['faits', memory.faits],
    ['histoires', memory.histoires],
    ['modele_personne', memory.modele_personne],
    ['graphe_noeuds', memory.graphe?.noeuds],
    ['graphe_liens', memory.graphe?.liens],
    ['relation', memory.relation],
    ['entity_core', memory.entity_core?.personnalite_acquise],
    ['autobiographie', memory.autobiographie?.episodes],
    ['monde_entity', memory.monde_entity],
    ['engagements', memory.engagements],
    ['moyen_terme', memory.moyen_terme],
    ['travail', memory.travail],
  ];

  for (const [type, value] of collections) {
    if (Array.isArray(value)) {
      value.forEach((item, index) => add(type, item, `${type}.${index}`));
    } else if (value && typeof value === 'object') {
      Object.entries(value).forEach(([key, item]) => {
        if (Array.isArray(item)) {
          item.forEach((child, index) => add(type, child, `${type}.${key}.${index}`));
        } else if (item && typeof item === 'object') {
          add(type, item, `${type}.${key}`);
        }
      });
    }
  }

  return candidates;
}

function memorySalience(item) {
  const importance = Number(item?.importance ?? item?.importance_personne ?? 0);
  const recence = Number(item?.recence ?? 0);
  const repetition = Math.min(Number(item?.repetition ?? item?.nombre_evocations ?? item?.nombre_mentions ?? 1), 10) / 10;
  const relation = Number(item?.force_relationnelle ?? item?.importance_entity ?? 0);
  const access = Number(item?.accessibilite ?? 1);
  const structural = item?.structurel === true ? 1 : 0;

  return (
    importance * 0.25 +
    recence * 0.15 +
    repetition * 0.15 +
    relation * 0.20 +
    access * 0.15 +
    structural * 0.10
  );
}

function memoryGraphBoost(candidate, selected) {
  if (!candidate?.item || !selected.length) return 0;

  const candidateText = candidate.text.toLowerCase();

  let links = 0;

  for (const chosen of selected) {
    const chosenText = chosen.text.toLowerCase();

    const candidateId = String(candidate.item.id || '');
    const chosenId = String(chosen.item.id || '');

    if (
      (candidateId && chosenText.includes(candidateId.toLowerCase())) ||
      (chosenId && candidateText.includes(chosenId.toLowerCase()))
    ) {
      links += 1;
    }
  }

  return Math.min(links, 3) * 0.04;
}

function memoryContentHash(text) {
  return crypto
    .createHash('sha256')
    .update(String(text || ''), 'utf8')
    .digest('hex');
}

async function getCachedMemoryEmbedding(apiKey, entityId, candidate, cache) {
  const hash = memoryContentHash(candidate.text);
  const key = candidate.path;

  const cached = cache[key];

  if (cached?.hash === hash && Array.isArray(cached.embedding)) {
    return cached.embedding;
  }

  const embedding = await getEmbedding(apiKey, candidate.text);

  cache[key] = {
    hash,
    embedding,
  };

  return embedding;
}

function embeddingBucket(embedding, bits = 12) {
  if (!Array.isArray(embedding) || !embedding.length) return null;

  let key = "";
  for (let i = 0; i < bits; i += 1) {
    const index = Math.floor((i * embedding.length) / bits);
    key += Number(embedding[index] || 0) >= 0 ? "1" : "0";
  }
  return key;
}

function neighboringBuckets(bucket, radius = 2) {
  if (!bucket) return [];

  const results = new Set([bucket]);

  function addFlips(source, count, start = 0) {
    if (count === 0) {
      results.add(source);
      return;
    }

    for (let i = start; i <= source.length - count; i += 1) {
      const chars = source.split("");
      chars[i] = chars[i] === "1" ? "0" : "1";

      if (count === 1) {
        results.add(chars.join(""));
      } else {
        addFlips(chars.join(""), count - 1, i + 1);
      }
    }
  }

  addFlips(bucket, 1);

  if (radius >= 2) addFlips(bucket, 2);

  return [...results];
}

function loadMemoryRecallIndex(entityId) {
  try {
    const file = path.join(
      ENTITY_EMBEDDING_DIR,
      `${safeEntityId(entityId)}.index.json`
    );

    if (!fs.existsSync(file)) return null;

    const data = JSON.parse(fs.readFileSync(file, "utf8"));

    if (
      !data ||
      typeof data !== "object" ||
      !data.buckets ||
      !data.entries
    ) {
      return null;
    }

    return data;
  } catch {
    console.warn("[entity] index mémoire illisible");
    return null;
  }
}

function saveMemoryRecallIndex(entityId, index) {
  const safeId = safeEntityId(entityId);
  if (!safeId) return;

  fs.mkdirSync(ENTITY_EMBEDDING_DIR, { recursive: true });

  const file = path.join(
    ENTITY_EMBEDDING_DIR,
    `${safeId}.index.json`
  );

  fs.writeFileSync(file, JSON.stringify(index), "utf8");
}

async function buildMemoryRecallIndex(
  apiKey,
  entityId,
  memory,
  candidates,
  embeddingCache
) {
  const entries = {};
  const buckets = {};

  for (const candidate of candidates) {
    const embedding = await getCachedMemoryEmbedding(
      apiKey,
      entityId,
      candidate,
      embeddingCache
    );

    const bucket = embeddingBucket(embedding);

    if (!bucket) continue;

    entries[candidate.path] = {
      bucket,
      type: candidate.type,
    };

    if (!buckets[bucket]) buckets[bucket] = [];

    buckets[bucket].push(candidate.path);
  }

  saveEntityEmbeddings(entityId, embeddingCache);

  const index = {
    version: 1,
    bits: 12,
    buckets,
    entries,
  };

  saveMemoryRecallIndex(entityId, index);

  return index;
}

function getMemoryItemByPath(memory, memoryPath) {
  const parts = String(memoryPath || "").split(".");
  let value = memory;

  for (const part of parts) {
    if (value == null) return null;

    if (/^\d+$/.test(part)) {
      value = Array.isArray(value)
        ? value[Number(part)]
        : null;
    } else {
      value = value[part];
    }
  }

  return value && typeof value === "object" ? value : null;
}

function candidateFromIndexedPath(memory, indexEntry, memoryPath) {
  const item = getMemoryItemByPath(memory, memoryPath);
  if (!item) return null;

  return {
    type: indexEntry?.type || "inconnu",
    path: memoryPath,
    item,
    text: JSON.stringify(item),
  };
}

async function selectRelevantMemory(apiKey, entityId, memory, conversation) {
  if (!memory || typeof memory !== "object") return null;

  const queryEmbedding = await getEmbedding(apiKey, conversation);

  const embeddingCache = loadEntityEmbeddings(entityId);
  let index = loadMemoryRecallIndex(entityId);

  /*
   * L'index est construit uniquement lorsqu'il n'existe pas encore.
   * Les tours suivants ne parcourent plus toute la mémoire.
   */
  if (!index) {
    const candidates = collectMemoryCandidates(memory);

    if (!candidates.length) return null;

    index = await buildMemoryRecallIndex(
      apiKey,
      entityId,
      memory,
      candidates,
      embeddingCache
    );
  }

  const queryBucket = embeddingBucket(queryEmbedding, index.bits || 12);
  const bucketKeys = neighboringBuckets(queryBucket, 2);

  const candidatePaths = new Set();

  for (const bucket of bucketKeys) {
    for (const memoryPath of index.buckets[bucket] || []) {
      candidatePaths.add(memoryPath);
    }
  }

  /*
   * Sécurité : si la zone locale ne contient rien,
   * on élargit progressivement le rappel.
   */
  if (!candidatePaths.size) {
    for (const bucket of Object.keys(index.buckets)) {
      for (const memoryPath of index.buckets[bucket]) {
        candidatePaths.add(memoryPath);

        if (candidatePaths.size >= 80) break;
      }

      if (candidatePaths.size >= 80) break;
    }
  }

  const scored = [];

  for (const memoryPath of candidatePaths) {
    const entry = index.entries[memoryPath];
    const candidate = candidateFromIndexedPath(
      memory,
      entry,
      memoryPath
    );

    if (!candidate) continue;

    const embedding = embeddingCache[memoryPath]?.embedding;

    if (!Array.isArray(embedding)) continue;

    const semantic = cosineSimilarity(queryEmbedding, embedding);
    const salience = memorySalience(candidate.item);

    scored.push({
      ...candidate,
      semantic,
      salience,
      score: semantic * 0.70 + salience * 0.30,
    });
  }

  scored.sort((a, b) => b.score - a.score);

  const selected = [];

  for (const candidate of scored) {
    if (selected.length >= 12) break;

    const alreadySelected = selected.some(
      (item) => item.path === candidate.path
    );

    if (alreadySelected) continue;

    selected.push(candidate);
  }

  if (!selected.length) return null;

  return selected;
}

async function generateEntityMessage(apiKey, entityId, conversation, memory, departure) {
  let lastProblem = '';

  for (let attempt = 0; attempt < 2; attempt += 1) {
    const retry = attempt === 0
      ? ''
      : `\nIMPORTANT : la tentative précédente était invalide (${lastProblem}). Réponds à nouveau, directement, sans répéter cette erreur.`;

    const relevantMemory = await selectRelevantMemory(apiKey, entityId, memory, conversation);

    const prompt = `${DIALOGUE_PROMPT}${retry}

--- MÉMOIRE PERTINENTE POUR CET ÉCHANGE ---

${relevantMemory ? JSON.stringify(relevantMemory, null, 2) : "Aucune mémoire pertinente disponible."}

--- CONVERSATION RÉCENTE ---

${conversation}`;

    const text = await openai(apiKey, prompt, { maxOutputTokens: 1200, temperature: 0.7 });
    const message = String(text || '').trim();
    const problem = validateMessage(message, departure);

    if (!problem) return message;
    lastProblem = problem;
  }

  throw new Error(`Réponse Entity invalide: ${lastProblem || 'format inconnu'}`);
}

async function handleEntity(req, res) {
  const { messages = [], entityId } = await readJson(req);
  const apiKey = process.env.OPENAI_API_KEY;

  if (!apiKey) return sendJson(res, 500, { error: 'OPENAI_API_KEY manquante dans .env.local' });
  if (!Array.isArray(messages) || messages.length === 0) return sendJson(res, 400, { error: 'Conversation vide' });
  if (!entityId) return sendJson(res, 400, { error: 'Identité Entity manquante' });

  // Entity ne renvoie pas toute son histoire au modèle.
  // La mémoire persistante porte le passé ; seuls les échanges récents
  // constituent le contexte conversationnel immédiat.
  const RECENT_MESSAGE_LIMIT = 12;
  const recentMessages = messages.slice(-RECENT_MESSAGE_LIMIT);
  const conversation = transcript(recentMessages);
  const latestUser = messages.filter((m) => m.role === 'user').at(-1)?.content || '';
  const departure = explicitDeparture(latestUser);

  const previousMemory = loadEntityMemory(entityId);

  const message = await generateEntityMessage(
    apiKey,
    entityId,
    conversation,
    previousMemory,
    departure
  );

  // La mémoire n'est consolidée que par cycles.
  // Entre deux consolidations, les échanges récents restent disponibles
  // dans la fenêtre conversationnelle immédiate.
  const MEMORY_CONSOLIDATION_INTERVAL = 6;
  const userMessageCount = messages.filter((m) => m.role === 'user').length;

  appendPendingMemory(entityId, [
    { role: 'user', content: latestUser },
    { role: 'assistant', content: message },
  ]);

  let memory = previousMemory;

  if (userMessageCount % MEMORY_CONSOLIDATION_INTERVAL === 0) {
    const pendingMessages = loadPendingMemory(entityId);
    const newConversation = transcript(pendingMessages);

    const consolidatedMemory = await buildEntityMemory(
      apiKey,
      previousMemory,
      newConversation
    );

    if (consolidatedMemory) {
      memory = consolidatedMemory;
      saveEntityMemory(entityId, memory);
      clearPendingMemory(entityId);
    } else {
      console.warn('[entity] consolidation mémoire reportée — échanges conservés');
    }
  }

  return sendJson(res, 200, { message, memory });
}

const server = http.createServer(async (req, res) => {
  try {
    if (req.method === 'POST' && req.url === '/api/entity') return await handleEntity(req, res);
    if (req.method === 'GET' && req.url === '/health') return sendJson(res, 200, { ok: true, service: 'entity' });
    return sendJson(res, 404, { error: 'Not found' });
  } catch (error) {
    console.error('[entity]', error?.message || error);
    return sendJson(res, 500, { error: error?.message || 'Erreur Entity' });
  }
});

server.listen(PORT, '127.0.0.1', () => {
  console.log(`[entity] API locale sur http://127.0.0.1:${PORT}`);
});
