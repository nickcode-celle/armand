const PORT = Number(process.env.ENTITY_API_PORT || 4401);

const ENTITY_MEMORY_DIR = path.resolve(process.cwd(), '.entity-memories');
const ENTITY_EMBEDDING_DIR = path.resolve(process.cwd(), '.entity-embeddings');

function entityEmbeddingFile(entityId) {
  const safeId = String(entityId || '').replace(/[^a-zA-Z0-9_-]/g, '');
  if (!safeId) return null;
  return path.join(ENTITY_EMBEDDING_DIR, `${safeId}.json`);
}

function loadEntityEmbeddings(entityId) {
  try {
    const file = entityEmbeddingFile(entityId);
    if (!file || !fs.existsSync(file)) return {};
    const data = JSON.parse(fs.readFileSync(file, 'utf8'));
    return data && typeof data === 'object' ? data : {};
  } catch {
    console.warn('[entity] cache embeddings illisible');
    return {};
  }
}

function saveEntityEmbeddings(entityId, embeddings) {
  const file = entityEmbeddingFile(entityId);
  if (!file) return;
  fs.mkdirSync(ENTITY_EMBEDDING_DIR, { recursive: true });
  fs.writeFileSync(file, JSON.stringify(embeddings), 'utf8');
}

const ENTITY_MEMORY_TYPES = [
  'travail',
  'moyen_terme',
  'faits',
  'histoires',
  'graphe',
  'modele_personne',
  'relation',
  'entity_core',
  'autobiographie',
  'monde_entity',
  'engagements',
];

function safeEntityId(entityId) {
  return String(entityId || '').replace(/[^a-zA-Z0-9_-]/g, '');
}

function entityMemoryFolder(entityId) {
  const safeId = safeEntityId(entityId);
  if (!safeId) return null;
  return path.join(ENTITY_MEMORY_DIR, safeId);
}

function entityMemoryFile(entityId, type) {
  const folder = entityMemoryFolder(entityId);
  if (!folder || !ENTITY_MEMORY_TYPES.includes(type)) return null;
  return path.join(folder, `${type}.json`);
}

function entityPendingMemoryFile(entityId) {
  const folder = entityMemoryFolder(entityId);
  if (!folder) return null;
  return path.join(folder, 'pending.json');
}

function loadPendingMemory(entityId) {
  try {
    const file = entityPendingMemoryFile(entityId);
    if (!file || !fs.existsSync(file)) return [];
    const data = JSON.parse(fs.readFileSync(file, 'utf8'));
    return Array.isArray(data) ? data : [];
  } catch {
    console.warn('[entity] échanges mémoire en attente illisibles');
    return [];
  }
}

function savePendingMemory(entityId, messages) {
  const file = entityPendingMemoryFile(entityId);
  if (!file) return;
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, JSON.stringify(messages, null, 2), 'utf8');
}

function appendPendingMemory(entityId, messages) {
  const pending = loadPendingMemory(entityId);
  pending.push(...messages);
  savePendingMemory(entityId, pending);
}

function clearPendingMemory(entityId) {
  const file = entityPendingMemoryFile(entityId);
  if (file && fs.existsSync(file)) fs.unlinkSync(file);
}

function loadEntityMemory(entityId) {
  const memory = {};

  for (const type of ENTITY_MEMORY_TYPES) {
    try {
      const file = entityMemoryFile(entityId, type);

      if (!file || !fs.existsSync(file)) {
        memory[type] = null;
        continue;
      }

      memory[type] = JSON.parse(fs.readFileSync(file, 'utf8'));
    } catch {
      console.warn(`[entity] mémoire ${type} illisible`);
      memory[type] = null;
    }
  }

  return Object.values(memory).some((value) => value !== null)
    ? memory
    : null;
}

function saveEntityMemory(entityId, memory) {
  if (!memory || typeof memory !== 'object') return;

  for (const type of ENTITY_MEMORY_TYPES) {
    if (!(type in memory) || memory[type] == null) continue;

    const file = entityMemoryFile(entityId, type);
    if (!file) continue;

    fs.mkdirSync(path.dirname(file), { recursive: true });
    fs.writeFileSync(
      file,
      JSON.stringify(memory[type], null, 2),
      'utf8'
    );
  }
}

